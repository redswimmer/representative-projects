{
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^C[0-9]+$"},
              "name": {"type": "string"},
              "description": {"type": "string"},
              "addresses": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^P[0-9]+$"}
              },
              "justification": {"type": "string"}
            },
            "required": ["id", "name", "description", "addresses", "justification"],
            "additionalProperties": false
          }
        },
        "roadmap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "milestone": {"type": "string"},
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^C[0-9]+$"}
              }
            },
            "required": ["milestone", "components"],
            "additionalProperties": false
          }
        }
      },
      "required": ["title", "summary", "components", "roadmap"],
      "additionalProperties": false
    }
  },
  "required": ["project"],
  "additionalProperties": false
}
