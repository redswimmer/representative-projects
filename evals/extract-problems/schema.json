{
  "type": "object",
  "properties": {
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]+$" },
          "problem": { "type": "string" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rationale": { "type": "string" }
        },
        "required": ["id", "problem", "evidence", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": ["problems"],
  "additionalProperties": false
}
